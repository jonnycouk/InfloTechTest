@model List<UserManagement.Web.Models.Logs.LogListItemViewModel>

<h2>Log Viewer</h2>

<div class="card p-0 mt-2">
    <div class="card-header alert-primary">
        Showing the last @Model.Count entries
    </div>

    <div class="card-body mt-2">

        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                <tr>
                    <th>Id</th>
                    <th>Summary</th>
                    <th>Detail</th>
                    <th>Date/Time</th>
                    <th>Affected ID</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    var timeSpan = DateTime.UtcNow - item.CreatedUtc;
                    var displayTime = timeSpan.TotalSeconds < 10 && timeSpan.TotalSeconds >= 0
                        ? "Just Now"
                        : item.CreatedUtc.ToString("dd MMM yyyy HH:mm:ss");
                    
                   <tr>
                        <td>
                            @item.Id
                        </td>
                        <td>
                            @item.Summary
                        </td>
                        <td>
                            <a href="/Logs/View/@item.Id" title="View full log entry" class="btn btn-outline-secondary">View Detail</a>
                        </td>
                        <td>
                            <span title="@item.CreatedUtc.ToString("dd MMM yyyy HH:mm:ss")">
                                @displayTime
                            </span>
                        </td>
                        <td>
                            @if (item.AffectedUserId != null)
                            {
                                <a href="/Users/View/@item.AffectedUserId" class="btn btn-outline-secondary">@item.AffectedUserId</a>
                            }

                        </td>
                    </tr>
                }
                </tbody>
            </table>

        </div>

    </div>

</div>