@model UserManagement.Sdk.Model.UserDto

@{
    var usersFullName = $"{Model.Forename ?? ""} {Model.Surname ?? ""}";
}


<div class="card">
    <div class="card-header alert-primary">Edit User</div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <p>You are editing details for @usersFullName.</p>
                <p><strong>ID: @Model.Id</strong></p>
            </div>

            <div class="col-12 pt-3">
                
                @using (Html.BeginForm("Update", "Users", FormMethod.Post))
                {
                    @Html.HiddenFor(user => user.Id)
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="row">
                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(user => user.Forename, new { @class = "form-label required-label" })
                                @Html.EditorFor(user => user.Forename, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(user => user.Forename, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(user => user.Surname, new { @class = "form-label required-label" })
                                @Html.EditorFor(user => user.Surname, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(user => user.Surname, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        
                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(user => user.Organisation, new { @class = "form-label required-label" })
                                @Html.EditorFor(user => user.Organisation, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(user => user.Organisation, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(user => user.JobTitle, new { @class = "form-label required-label" })
                                @Html.EditorFor(user => user.JobTitle, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(user => user.JobTitle, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(user => user.Email, new { @class = "form-label required-label" })
                                @Html.EditorFor(user => user.Email, new { htmlAttributes = new { @class = "form-control", type = "email" } })
                                @Html.ValidationMessageFor(user => user.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>
                        
                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(user => user.DateOfBirth, new { @class = "form-label required-label" })
                                @Html.EditorFor(user => user.DateOfBirth, new { htmlAttributes = new { @class = "form-control", type = "date", max = DateTime.Now.ToString("yyyy-MM-dd") } })
                                @Html.ValidationMessageFor(user => user.DateOfBirth, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>
                    
                    <p class="small">Note: Password resets must be performed by the user, using the Password Reset service.</p>

                    <div class="row m-2">
                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">

                                <div class="form-check form-switch mt-2">
                                    @Html.CheckBoxFor(user => user.IsActive, new { @class = "form-check-input", role = "switch" })
                                    <label class="form-check-label" for="@Html.IdFor(user => user.IsActive)">Set User As
                                        Active</label>
                                </div>

                                @Html.ValidationMessageFor(user => user.IsActive, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    
                    <div class="row mt-4">
                        <div class="col-12">
                            <a href="/Users/List" class="btn btn-outline-secondary m-2" title="Back to List">Back to List</a>
                            
                            @if (Model.Id != 1)
                            {
                                <button type="submit" class="btn btn-success">Save Changes</button>
                            }
                            
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>