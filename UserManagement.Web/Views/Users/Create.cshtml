@model UserManagement.Models.User

<div class="card">
    <div class="card-header alert-primary">Create New User</div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <p>Add a new user to the system. Please complete all the fields below.</p>
            </div>

            <div class="col-12 pt-3">
                @using (Html.BeginForm("Create", "Users", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row">
                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.Forename, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.Forename, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(x => x.Forename, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.Surname, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.Surname, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(x => x.Surname, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.Email, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.Email, new { htmlAttributes = new { @class = "form-control", type = "email" } })
                                @Html.ValidationMessageFor(x => x.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.DateOfBirth, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.DateOfBirth, new { htmlAttributes = new { @class = "form-control", type = "date", max = DateTime.Now.ToString("yyyy-MM-dd") } })
                                @Html.ValidationMessageFor(x => x.DateOfBirth, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">Create User</button>
                            <p class="small mt-3"><strong>Note:</strong> For security, new users are set as <code>NOT ACTIVE</code> by default. This status can be changed by editing the user from the User List screen.</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>