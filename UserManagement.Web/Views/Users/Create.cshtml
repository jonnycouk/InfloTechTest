@model UserManagement.Web.ViewModels.UserViewModel

<div class="card">
    <div class="card-header alert-primary">Create New User</div>
    <div class="card-body">
        <div class="row">
            <div class="col-12">
                <p>Add a new user to the system. Please complete all the fields below.</p>
            </div>

            <div class="col-12 pt-3">

                @using (Html.BeginForm("Create", "Users", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <div class="row">
                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.User.Forename, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.User.Forename, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(x => x.User.Forename, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.User.Surname, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.User.Surname, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(x => x.User.Surname, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.User.Organisation, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.User.Organisation, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(x => x.User.Organisation, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.User.JobTitle, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.User.JobTitle, new { htmlAttributes = new { @class = "form-control" } })
                                @Html.ValidationMessageFor(x => x.User.JobTitle, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.User.Email, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.User.Email, new { htmlAttributes = new { @class = "form-control", type = "email" } })
                                @Html.ValidationMessageFor(x => x.User.Email, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.User.DateOfBirth, new { @class = "form-label required-label" })
                                @Html.EditorFor(x => x.User.DateOfBirth, new { htmlAttributes = new { @class = "form-control", type = "date", max = DateTime.Now.ToString("yyyy-MM-dd") } })
                                @Html.ValidationMessageFor(x => x.User.DateOfBirth, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.Password, new { @class = "form-label required-label" })
                                @Html.PasswordFor(x => x.Password, new { @class = "form-control", autocomplete = "new-password" })
                                @Html.ValidationMessageFor(x => x.Password, "", new { @class = "text-danger" })
                            </div>
                        </div>

                        <div class="col-md-6 col-sm-12 mb-3">
                            <div class="form-group">
                                @Html.LabelFor(x => x.ConfirmPassword, new { @class = "form-label required-label" })
                                @Html.PasswordFor(x => x.ConfirmPassword, new { @class = "form-control", autocomplete = "new-password" })
                                @Html.ValidationMessageFor(x => x.ConfirmPassword, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <a href="/Users/List" class="btn btn-outline-secondary m-2" title="Back to List">Back to List</a>
                            <button type="submit" class="btn btn-success">Create User</button>
                            <p class="small mt-3"><strong>Note:</strong> For security, new users are set as <code>NOT ACTIVE</code> by default. This status can be changed by editing the user from the User List screen.</p>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
